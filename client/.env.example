# URL of the Billingly API server (no trailing slash, no /api suffix — that's added automatically).
# Falls back to http://localhost:5000 in development if unset.
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID (console.cloud.google.com > APIs & Services > Credentials)
# Must match GOOGLE_CLIENT_ID in the server's .env for token verification to work.
VITE_GOOGLE_CLIENT_ID=
